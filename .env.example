APP_PORT=8001
POSTGRES_DB=mlops
POSTGRES_USER=mlops
POSTGRES_PASSWORD=mlops_local_password

# MLflow backend store
MLFLOW_DB_NAME=mlflow
MLFLOW_DB_USER=mlflow
MLFLOW_DB_PASSWORD=mlflow_local_password

# RustFS (MLflow artifact store)
S3_ACCESS_KEY=mlflow_local_access
S3_SECRET_KEY=mlflow_local_secret_key
MLFLOW_BUCKET=mlflow

# Inference model registered by the training pipeline.
# Docker Compose supplies MLFLOW_TRACKING_URI=http://mlflow:5000 to the worker.
# For a local host process, export MLFLOW_TRACKING_URI=http://127.0.0.1:5000.
MLFLOW_MODEL_NAME=claim-veracity
MLFLOW_MODEL_ALIAS=champion

RABBITMQ_URL=amqp://guest:guest@127.0.0.1:5673/
QUEUE_MAX_LENGTH=20
PREFETCH_COUNT=1
INFERENCE_DELAY_SECONDS=0.05

# Observability (Docker uses the internal endpoint; host processes use localhost:4318).
COMPOSE_PROJECT_NAME=mlops-initial
LOG_LEVEL=INFO
DEPLOYMENT_ENVIRONMENT=local
OTEL_SDK_DISABLED=false
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
OTEL_RESOURCE_ATTRIBUTES=deployment.environment.name=local
OTEL_TRACES_SAMPLER=parentbased_always_on
OTEL_TRACES_SAMPLER_ARG=1.0
GRAFANA_PASSWORD=mlops-local-grafana
OTEL_COLLECTOR_VERSION=0.123.0
ALLOY_VERSION=v1.8.3
LOKI_VERSION=3.4.2
TEMPO_VERSION=2.7.2
PROMETHEUS_VERSION=v3.2.1
GRAFANA_VERSION=11.6.0
