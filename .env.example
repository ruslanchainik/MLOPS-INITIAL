APP_PORT=8001
POSTGRES_DB=mlops
POSTGRES_USER=mlops
# TODO: Пример пароля, пока так
POSTGRES_PASSWORD=mlops_local_password

# MLflow backend store
MLFLOW_DB_NAME=mlflow
MLFLOW_DB_USER=mlflow
MLFLOW_DB_PASSWORD=mlflow_local_password

# RustFS (MLflow artifact store)
S3_ACCESS_KEY=mlflow_local_access
S3_SECRET_KEY=mlflow_local_secret_key
MLFLOW_BUCKET=mlflow

# Inference model registered by the training pipeline.
# Docker Compose supplies MLFLOW_TRACKING_URI=http://mlflow:5000 to the app.
# For a local host process, export MLFLOW_TRACKING_URI=http://127.0.0.1:5000.
MLFLOW_MODEL_NAME=claim-veracity
MLFLOW_MODEL_ALIAS=champion
