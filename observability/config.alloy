logging {
	level  = "warn"
	format = "json"
}

discovery.docker "project" {
	host             = "unix:///var/run/docker.sock"
	refresh_interval = "1s"

	filter {
		name   = "label"
		values = ["com.docker.compose.project=" + sys.env("COMPOSE_PROJECT")]
	}
}

discovery.relabel "logs" {
	targets = discovery.docker.project.targets

	rule {
		source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
		regex         = "app|source|worker"
		action        = "keep"
	}

	rule {
		source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
		target_label  = "service"
	}
}

loki.source.docker "project" {
	host       = "unix:///var/run/docker.sock"
	targets    = discovery.relabel.logs.output
	labels     = {}
	forward_to = [loki.process.json.receiver]
}

loki.process "json" {
	stage.json {
		expressions = {level = "level", env = "env"}
	}

	stage.labels {
		values = {level = "", env = ""}
	}

	stage.label_keep {
		values = ["service", "level", "env"]
	}
	forward_to = [loki.write.local.receiver]
}

loki.write "local" {
	endpoint {
		url = "http://loki:3100/loki/api/v1/push"
	}
}
